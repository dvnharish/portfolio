# ---------------------------------------------------------------------------
# harishduddupudi.com — Apache / LiteSpeed config for Hostinger shared hosting
#
# Copied into out/ by scripts/finalize-export.mjs during `npm run build`.
# Upload the CONTENTS of out/ into public_html, including this file.
#
# Next.js `headers()` does not work in a static export, so every caching,
# compression and security header the app needs is declared here instead.
# ---------------------------------------------------------------------------

# --- Force HTTPS and a single canonical host -------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http -> https. HTTPS is not always set on LiteSpeed behind a proxy, so also
  # honour the forwarded header.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www -> apex, so canonical URLs and analytics do not split.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Serve extensionless URLs from their .html file (e.g. /404 -> /404.html).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# --- MIME types ------------------------------------------------------------
# Older Apache builds do not know these, and a wrong type means the browser
# refuses the asset outright.
<IfModule mod_mime.c>
  AddType image/avif                     .avif
  AddType image/webp                     .webp
  AddType application/manifest+json      .webmanifest
  AddType font/woff2                     .woff2
  AddType image/svg+xml                  .svg
  AddType application/json               .json
  AddCharset UTF-8                       .html .css .js .json .svg .webmanifest
</IfModule>

# --- Compression -----------------------------------------------------------
# Images and fonts are already compressed; re-compressing them wastes CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# --- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Next's build output is fingerprinted by filename — safe to pin forever.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Frame sequence and portrait derivatives. Frame URLs carry a ?v= content
  # hash (see lib/sequence.ts), so a re-export changes the URL and returning
  # visitors are not pinned to stale artwork.
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML must always revalidate, or a deploy never reaches anyone.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # --- Security headers ----------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

  # This is a fully static site: no XHR, no inline event handlers, no external
  # origins. `unsafe-inline` on style-src is required by Next's inlined critical
  # CSS; on script-src by the pre-paint theme script in app/layout.tsx.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# --- Hardening -------------------------------------------------------------
# No directory listings if an index is ever missing.
Options -Indexes

# Block dotfiles other than this one.
<FilesMatch "^\.(?!htaccess$)">
  Require all denied
</FilesMatch>
